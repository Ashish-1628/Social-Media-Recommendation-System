# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="GraphConnect API"
DEBUG=false

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (zero-config, great for development)
DATABASE_URL=sqlite:///./graphconnect.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/graphconnect

# ── JWT Security ───────────────────────────────────────────────────────────────
# IMPORTANT: Change this to a long random string in production!
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-secret-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24 hours

# ── Redis (optional) ──────────────────────────────────────────────────────────
# Leave blank to disable recommendation caching (works fine without Redis)
REDIS_URL=redis://localhost:6379/0
